public class Diamond {
	public static void main(String[] args) {
		int n=5;
		char star='*';
		char space=' ';
		for(int i=1;i<=(n*2)-1;i++) {
			if(i<=(n*2)/2) {
				for(int k=1;k<=n-i;k++) {
					System.out.print(space);
				}
				for(int j=1;j<=(2*i)-1;j++) {
					System.out.print(star);
				}
			}
			else {
				for(int j=(n*2)-1;j>=j-i;j--) {
					System.out.print(star);
				}
			}
			System.out.println();
		}
	}

}
